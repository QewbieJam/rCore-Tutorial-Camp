diff -ruN a/samples/rust/rust_syscalls.rs b/samples/rust/rust_syscalls.rs
--- a/samples/rust/rust_syscalls.rs	1970-01-01 08:00:00.000000000 +0800
+++ b/samples/rust/rust_syscalls.rs	2026-10-20 21:12:08.750129493 +0800
@@ -0,0 +1,95 @@
+//! get_taskinfo 与系统调用计数的 Rust 实现。
+
+use core::sync::atomic::{AtomicU64, Ordering};
+
+use kernel::bindings;
+use kernel::ffi::{c_char, c_long, c_uint};
+use kernel::uaccess::UserSlice;
+
+const MAX_SYSCALLS: usize = 512;
+const EINVAL: c_long = -22;
+const EFAULT: c_long = -14;
+
+/// 与用户态 `struct taskinfo` 布局一致
+#[repr(C)]
+pub struct TaskInfo {
+    tid: u32,
+    pid: u32,
+    comm:[u8; 16],
+}
+
+static COUNTS: [AtomicU64; MAX_SYSCALLS] =
+    [const { AtomicU64::new(0) }; MAX_SYSCALLS];
+
+
+
+/// 系统调用入口调用： 给 `nr` 计数
+#[no_mangle]
+pub extern "C" fn rust_syscall_stats_inc(nr: c_uint) {
+    if (nr as usize) < MAX_SYSCALLS {
+        COUNTS[nr as usize].fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// 返回某个系统调用被调用过的次数
+#[no_mangle]
+pub extern "C" fn rust_get_syscall_count(nr: c_uint) -> c_long {
+    if(nr as usize) >= MAX_SYSCALLS {
+        return EINVAL;
+    }
+    COUNTS[nr as usize].load(Ordering::Relaxed) as c_long
+}
+
+/// 清零所有系统调用计数
+#[no_mangle]
+pub extern "C" fn rust_reset_syscall_counts() -> c_long {
+    for c in COUNTS.iter() {
+        c.store(0, Ordering::Relaxed);
+    }
+    0
+}
+
+/// 把当前 task 的 tid / pid / comm 写入用户指针。
+///
+/// # Safety
+///
+/// `info` 必须是当前进程可写的用户地址，`len` 是它的字节数。
+#[no_mangle]
+pub unsafe extern "C" fn rust_get_taskinfo(info: *mut TaskInfo, len:usize) -> c_long {
+    if info.is_null() || len < core::mem::size_of::<TaskInfo>()
+    {
+        return EINVAL;
+    }
+
+    let mut k = TaskInfo {
+        tid: 0,
+        pid: 0,
+        comm: [0u8; 16],
+    };
+
+    k.tid = kernel::current!().pid() as u32;
+    k.pid = kernel::current!().group_leader().pid() as u32;
+
+    // SAFETY: get_current() 返回当前 task，调用期间有效。
+    unsafe {
+        bindings::__get_task_comm(
+            k.comm.as_mut_ptr() as *mut c_char,
+            k.comm.len(),
+            bindings::get_current(),
+        );
+    }
+
+    // SAFETY: k 是本地结构，按字节切片不会越界。
+    let bytes = unsafe {
+        core::slice::from_raw_parts(
+            &k as *const TaskInfo as *const u8,
+            core::mem::size_of::<TaskInfo>(),
+        )
+    };
+
+    let mut writer = UserSlice::new(info as usize, bytes.len()).writer();
+    match writer.write_slice(bytes) {
+        Ok(()) => 0,
+        Err(_) => EFAULT,
+    }
+}
